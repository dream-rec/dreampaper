{
  "name": "dreampaper",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node .github/scripts/check-icon.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev.mjs && tauri dev",
    "tauri:build": "node scripts/sidecar.mjs && tauri build",
    "test": "vitest run",
    "gate:ort": "node scripts/ort.mjs",
    "gate:ocr": "cargo run --release --manifest-path src-tauri/ocr/Cargo.toml --bin gate --",
    "gate:lifecycle": "cargo run --release --manifest-path src-tauri/ocr/Cargo.toml --bin lifecycle --",
    "sidecar": "node scripts/sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vitejs/plugin-react": "^5.0.0",
    "konva": "10.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "19.2.6",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  }
}
