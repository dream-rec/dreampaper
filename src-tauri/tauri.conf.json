{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DreamPaper",
  "version": "0.2.1",
  "identifier": "com.dreampaper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DreamPaper",
        "url": "index.desktop.html",
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["sidebar", "mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../prompts": "prompts",
      "fonts": "fonts"
    },
    "externalBin": ["binaries/dreampaper-ocr"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
